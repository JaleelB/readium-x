{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "readium-x",
  // Custom entry. Keep this pointed at worker.ts. OpenNext generates
  // .open-next/worker.js, and worker.ts imports it only after cheap paths return.
  "main": "worker.ts",
  "compatibility_date": "2026-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // false: files in public/ (robots.txt, sitemap.xml, /_next/static) are
    // served by Workers Static Assets and do not invoke the Worker at all.
    // Do not flip this to true unless you also want those requests billed.
    "run_worker_first": false,
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "readiumx.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.readiumx.com",
      "custom_domain": true,
    },
  ],
  "secrets": {
    "required": [
      "DATABASE_URL",
      "DB_AUTH_TOKEN",
      "CLERK_SECRET_KEY",
      "CLERK_WEBHOOK_SIGNING_SECRET",
      "ENCRYPTION_KEY",
      "NEXT_PUBLIC_APP_URL",
      "NEXT_PUBLIC_APP_NAME",
      "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    ],
  },
  "kv_namespaces": [
    {
      "binding": "READIUMX_ARTICLE_CACHE",
      "id": "4ea0e799b5a247f58c6483cbeda822b3",
      "preview_id": "6d9d163ddb3f492db8190870e1a30cec",
    },
  ],
}
