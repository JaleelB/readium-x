    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.31.2",
    "esbuild-register": "^3.5.0",
    "framer-motion": "^11.5.4",
    "jiti": "^1.21.6",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "lucide-react": "^0.399.0",
    "next": "16.2.5",
    "next-themes": "^0.3.0",
    "openai": "^4.56.0",
    "playwright": "^1.45.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.52.0",
    "react-wrap-balancer": "^1.1.1",
